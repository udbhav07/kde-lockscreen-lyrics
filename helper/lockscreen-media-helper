#!/usr/bin/env python3
"""
Follows every media player (Spotify, browsers, VLC ...) and saves the cover
and synced lyrics of the one the lock screen shows into
~/.cache/kde-lockscreen-lyrics, where the lock screen reads them:

  cover.jpg   lyrics.lrc   now.txt  (player, title, artist, source, expected length)

now.txt tells the lock screen which song the other two files belong to, so it
never shows one song's cover or lyrics with another song's title.
"""

import hashlib
import json
import re
import shutil
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

CACHE = Path.home() / ".cache/kde-lockscreen-lyrics"
SONGS = CACHE / "songs"                 # Spotify, by track id (shared with lockscreen-lyrics-prefetch)
MUSIC = CACHE / "youtube-music"         # LRCLIB lyrics for every other player
YT = CACHE / "youtube"                  # short-lived: thumbnails, captions, video ids
THUMBS, CAPTIONS, IDS = YT / "thumbs", YT / "captions", YT / "ids.tsv"
MAX_SONGS = 500
MAX_VIDEOS, VIDEO_DAYS = 200, 7
# Fedora's yt-dlp lacks its YouTube JavaScript solver; this fetches it from GitHub (accepted risk)
YTDLP_FLAGS = ("--js-runtimes", "node", "--remote-components", "ejs:github", "--no-warnings")
BROWSERS = re.compile(r"brave|chrom|edge|vivaldi|opera|firefox|librewolf|waterfox|plasma-browser-integration")
MAX_ART = 5 * 1024 * 1024
LRCLIB_BACKOFF = (5, 15, 30)            # waits after a failed LRCLIB request
UA = "kde-lockscreen-lyrics/0.2 (https://github.com/udbhav07/kde-lockscreen-lyrics)"

SEP = "\x1f"    # playerctl output field separator; never appears in titles
FIELDS = ("name", "status", "trackid", "art", "artist", "title", "length", "url", "kde_pid")
FORMAT = SEP.join(("{{playerInstance}}", "{{status}}", "{{mpris:trackid}}", "{{mpris:artUrl}}",
                   "{{artist}}", "{{title}}", "{{mpris:length}}", "{{xesam:url}}", "{{kde:pid}}"))


def log(*args):
    print(*args, flush=True)


# ---------------------------------------------------------------- HTTP

class HttpError(Exception):
    def __init__(self, status):
        super().__init__(f"HTTP {status}" if status else "network error")
        self.status = status


def http(url):
    request = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            return response.read()
    except urllib.error.HTTPError as e:
        raise HttpError(e.code) from None
    except OSError:
        raise HttpError(0) from None


# ---------------------------------------------------------------- players

def parse_snapshot(text):
    """playerctl -a metadata --format FORMAT output -> list of player dicts."""
    players = []
    for line in text.splitlines():
        parts = line.split(SEP)
        if len(parts) != len(FIELDS):
            continue    # "No player could handle this command" and similar
        p = dict(zip(FIELDS, parts))
        p["length"] = int(p["length"]) if p["length"].isdigit() else 0
        p["trackid"] = p["trackid"].strip("'")      # object paths come quoted
        players.append(p)
    return players


def snapshot():
    try:
        out = subprocess.run(["playerctl", "-a", "metadata", "--format", FORMAT],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    return parse_snapshot(out)


def dedupe(players):
    """Plasma Browser Integration repeats the browser's own player (and adds the
    page URL); drop the browser's copy, like Plasma's media applet does."""
    pids = {p["kde_pid"] for p in players if p["kde_pid"]}
    def own_pid(name):     # "brave.instance42" / "firefox.instance_1_42" -> "42"
        m = re.search(r"\.instance.*?(\d+)$", name)
        return m and m[1]
    return [p for p in players if own_pid(p["name"]) not in pids]


def is_spotify(name):
    return name.split(".")[0] == "spotify"     # "spotify", or "spotify.instance123" with two running


def pick(players, last_change):
    """The player to show: has a title, then playing, then Spotify, then most recently changed.
    The lock screen (NowPlaying.qml) uses the same order."""
    candidates = [p for p in players if p["title"]]
    if not candidates:
        return None
    return max(candidates, key=lambda p: (p["status"] == "Playing", is_spotify(p["name"]),
                                          last_change.get(p["name"], 0)))


# ---------------------------------------------------------------- cache

def evict(folder, max_items, max_age_days=None, keep=()):
    """Delete songs (all files sharing a name) older than max_age_days, then the
    least recently used ones while there are more than max_items."""
    songs = {}
    for f in folder.iterdir():
        if not f.name.startswith("."):
            songs.setdefault(f.stem, []).append(f)

    def last_used(stem):
        return max((f.stat().st_mtime for f in songs[stem] if f.exists()), default=0)

    stale = []
    if max_age_days is not None:
        cutoff = time.time() - max_age_days * 86400
        stale = [s for s in songs if s not in keep and last_used(s) < cutoff]
    rest = sorted((s for s in songs if s not in keep and s not in stale), key=last_used)
    extra = len(songs) - len(stale) - max_items
    for stem in stale + rest[:max(extra, 0)]:
        for f in songs[stem]:
            f.unlink(missing_ok=True)


def write_atomic(path, data):
    tmp = path.with_name(".tmp." + path.name)
    tmp.write_bytes(data)
    tmp.replace(path)


def one_line(text):
    """Tabs and newlines would break now.txt; NowPlaying.qml does the same cleanup."""
    return re.sub(r"[\t\r\n]", " ", text)


class Writer:
    """The only code that touches cover.jpg / lyrics.lrc / now.txt.

    Every song switch bumps `gen`; a download started for an older song still
    runs, but its writes are dropped. Switching and writing share one lock, so a
    write can never land between "clear the old files" and "now.txt names the
    new song"."""

    def __init__(self, folder):
        self.folder = folder
        self.lock = threading.Lock()
        self.gen = 0
        self.fields = None

    def switch(self, p):
        with self.lock:
            self.gen += 1
            for name in ("cover.jpg", "lyrics.lrc", "now.txt"):
                (self.folder / name).unlink(missing_ok=True)
            # player, title, artist, lyrics source, expected length (ms)
            self.fields = [p["name"], one_line(p["title"]), "", "", ""] if p else None
            self._write_now()
            return self.gen

    def alive(self, gen):
        return gen == self.gen

    def put(self, gen, name, data):
        with self.lock:
            if gen != self.gen:
                return False
            write_atomic(self.folder / name, data)
            return True

    def note(self, gen, artist=None, source=None, expected_ms=None):
        with self.lock:
            if gen != self.gen or self.fields is None:
                return
            for i, value in ((2, artist), (3, source), (4, expected_ms)):
                if value is not None:
                    self.fields[i] = one_line(str(value))
            self._write_now()

    def _write_now(self):
        if self.fields:
            write_atomic(self.folder / "now.txt", ("\t".join(self.fields) + "\n").encode())


# ---------------------------------------------------------------- cover

def read_art_file(url):
    """Bytes of a file:// cover, only if it is a small regular file in /tmp or
    your home (players put their temporary thumbnails there)."""
    path = Path(urllib.parse.unquote(urllib.parse.urlparse(url).path)).resolve()
    if not any(path.is_relative_to(d) for d in (Path("/tmp"), Path.home())):
        return None
    try:
        if not path.is_file() or path.stat().st_size > MAX_ART:
            return None
        return path.read_bytes()
    except OSError:
        return None


def fetch_art(url):
    if url.startswith("file://"):
        return read_art_file(url)
    if url.startswith(("https://", "http://")):
        try:
            data = http(url)
        except HttpError:
            return None
        return data if len(data) <= MAX_ART else None
    return None


# ---------------------------------------------------------------- lyrics

def clean_title(title):
    """Same cleanup as lockscreen-lyrics-prefetch: drop "(From ...)", "(feat. ...)", " - ..."."""
    title = re.sub(r" *[(\[](from|feat\.|ft\.)[^\])]*[\])]", "", title, count=1, flags=re.I)
    return re.sub(r" - .*$", "", title)


def choose_synced(results, length_s):
    """(lrc, duration) of the synced result within 2 s of length_s, else the first synced one."""
    synced = [r for r in results if r.get("syncedLyrics")]
    if not synced:
        return "", None
    close = [r for r in synced if length_s and abs(r.get("duration", 0) - length_s) <= 2]
    best = (close or synced)[0]
    return best["syncedLyrics"], best.get("duration")


def lrclib(artist, track, length_s, wait):
    """(lrc, duration). lrc is "" when LRCLIB has no synced lyrics, None when it
    never answered (so nothing gets cached and the next play asks again)."""
    queries = [("search", {"q": f"{artist} {track}".strip()})]
    if length_s:    # /get only matches within 2 s of the length, best when it works
        queries.insert(0, ("get", {"artist_name": artist, "track_name": track,
                                   "duration": round(length_s)}))
    for kind, params in queries:
        url = f"https://lrclib.net/api/{kind}?" + urllib.parse.urlencode(params)
        for pause in (*LRCLIB_BACKOFF, None):
            try:
                body = http(url)
                break
            except HttpError as e:
                if e.status == 404:
                    body = None
                    break
                if pause is None or not wait(pause):
                    return None, None
        if body is None:
            continue
        results = json.loads(body)
        lrc, duration = choose_synced([results] if isinstance(results, dict) else results, length_s)
        if lrc:
            return lrc, duration
    return "", None


def saved_lyrics(path, fetch):
    """Lyrics from `path`, else fetch() and remember the answer ("" = none)."""
    if path.exists():
        path.touch()
        return path.read_text().rstrip("\n")
    text = fetch()
    if text is None:
        return ""
    write_atomic(path, (text + "\n").encode() if text else b"")
    return text


# ---------------------------------------------------------------- YouTube

YT_TAGS = (r"official( music| lyrics?)? (video|audio)|official|lyrics?( video)?|audio|"
           r"visuali[sz]er|video|hd|4k|remaster(ed)?|full (video )?song")


def youtube_song(title, channel):
    """("Artist", "Track") for LRCLIB from a video title like
    "Artist - Track (Official Video)"; no dash -> the channel is the artist."""
    t = re.sub(r"#\w+", "", title)
    t = re.sub(rf"[(\[]\s*({YT_TAGS})\s*[)\]]", "", t, flags=re.I)
    t = re.sub(r"\s(HD|4K)\b", "", t)
    t = t.split("|")[0]
    parts = re.split(r"\s+[-–—]\s+", t.strip(), maxsplit=1)
    if len(parts) == 2:
        artist, track = parts
    else:
        artist, track = re.sub(r"( - Topic|VEVO)$", "", channel), parts[0]
    track = re.sub(r"\s+(ft\.|feat\.|featuring)\s.*$", "", clean_title(track), flags=re.I)
    return " ".join(artist.split()), " ".join(track.split())


def video_id(url):
    """The 11-character video id from a YouTube page URL, else None."""
    u = urllib.parse.urlparse(url)
    host = (u.hostname or "").removeprefix("www.").removeprefix("m.").removeprefix("music.")
    if host == "youtu.be":
        vid = u.path[1:]
    elif host == "youtube.com" and u.path == "/watch":
        vid = urllib.parse.parse_qs(u.query).get("v", [""])[0]
    elif host == "youtube.com" and re.match(r"/(shorts|live|embed)/", u.path):
        vid = u.path.split("/")[2]
    else:
        return None
    return vid if re.fullmatch(r"[A-Za-z0-9_-]{11}", vid) else None


def lrc_time(ms):
    return f"[{ms // 60000:02d}:{ms % 60000 / 1000:05.2f}]"


def json3_to_lrc(data):
    """YouTube json3 captions -> LRC. Breaks of 4 s or more get an empty line,
    which LyricsView shows as breathing dots."""
    lines, last, end = [], None, None
    for e in data.get("events", []):
        if e.get("aAppend") or "segs" not in e:
            continue
        text = "".join(s.get("utf8", "") for s in e["segs"])
        text = re.sub(r"♪|\[(Music|Applause|Laughter)\]", "", text.replace("\n", " "), flags=re.I)
        text = " ".join(text.split())
        if not text or text == last:
            continue
        start = e.get("tStartMs", 0)
        if end is not None and start - end >= 4000:
            lines.append(lrc_time(end))
        lines.append(lrc_time(start) + text)
        last, end = text, start + e.get("dDurationMs", 0)
    return "\n".join(lines)


def shift_lrc(lrc, seconds):
    def move(m):
        ms = round((int(m[1]) * 60 + float(m[2]) + seconds) * 1000)
        return lrc_time(max(ms, 0))
    return re.sub(r"^\[(\d+):(\d+(?:\.\d+)?)\]", move, lrc, flags=re.M)


def intro_offset(video_s, track_s):
    """Music videos often start with an intro the album track doesn't have: when
    the video is 3-30 s longer than LRCLIB's track, shift the lyrics by that much."""
    if not track_s:
        return 0
    diff = round(video_s - track_s)
    return diff if 3 <= diff <= 30 else 0


def ad_playing(length_us, expected_ms):
    """During a YouTube ad the browser keeps the video's title but reports the ad's length."""
    return bool(expected_ms) and abs(length_us / 1000 - expected_ms) > 2000


def ytdlp(args, alive, timeout=60):
    """yt-dlp's stdout, or None when it is missing, fails, is too slow, or the song changed."""
    if not shutil.which("yt-dlp"):
        return None
    try:
        proc = subprocess.Popen(["yt-dlp", *YTDLP_FLAGS, *args], text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return None
    deadline = time.monotonic() + timeout
    while True:
        try:
            out, _ = proc.communicate(timeout=0.2)
            return out if proc.returncode == 0 else None
        except subprocess.TimeoutExpired:
            if not alive() or time.monotonic() > deadline:
                proc.kill()
                proc.communicate()
                return None


def match_search(entries, title, channel, length_s):
    """(id, duration_ms) of the search result from the same channel, with the same
    title and length (re-uploads often share a title), else None."""
    def norm(text):
        return " ".join((text or "").casefold().split())
    for e in entries or []:
        if (e.get("id") and e.get("channel") == channel and norm(e.get("title")) == norm(title)
                and e.get("duration") is not None and abs(e["duration"] - length_s) <= 2):
            return e["id"], round(e["duration"] * 1000)
    return None


def caption_url(info, kind):
    """json3 URL of the manual captions (English first), or of the auto-generated
    ones in the video's own language ("<lang>-orig")."""
    tracks = info.get("subtitles" if kind == "manual" else "automatic_captions") or {}
    names = [n for n in tracks if n != "live_chat" and (kind == "manual" or n.endswith("-orig"))]
    names.sort(key=lambda n: not n.startswith("en"))
    for name in names:
        for fmt in tracks[name]:
            if fmt.get("ext") == "json3" and fmt.get("url"):
                return fmt["url"]
    return None


def recall(path, key):
    try:
        for line in path.read_text().splitlines():
            k, vid, ms, at = (line.split("\t") + ["", "", "", "0"])[:4]
            if k == key and float(at) > time.time() - VIDEO_DAYS * 86400:
                return vid, int(ms or 0)
    except OSError:
        pass
    return None


def remember(path, key, vid, ms):
    """Saves key -> (video id, length); rows older than VIDEO_DAYS are dropped."""
    cutoff = time.time() - VIDEO_DAYS * 86400
    try:
        rows = [line for line in path.read_text().splitlines()
                if line.split("\t")[0] != key and float((line.split("\t") + ["0"] * 4)[3]) > cutoff]
    except OSError:
        rows = []
    rows.append(f"{key}\t{vid}\t{ms}\t{int(time.time())}")
    write_atomic(path, ("\n".join(rows[-4 * MAX_VIDEOS:]) + "\n").encode())


# ---------------------------------------------------------------- per player

def spotify_song(w, p, gen, wait):
    tid = re.split(r"[/:]", p["trackid"])[-1]
    if not re.fullmatch(r"[A-Za-z0-9]+", tid):
        return other_song(w, p, gen, wait)
    jpg, lrc = SONGS / f"{tid}.jpg", SONGS / f"{tid}.lrc"
    if jpg.exists():
        jpg.touch()
        cover = jpg.read_bytes()
    else:
        cover = fetch_art(p["art"])
        if cover:
            write_atomic(jpg, cover)
    if cover:
        w.put(gen, "cover.jpg", cover)

    length_s = p["length"] / 1e6 or None
    text = saved_lyrics(lrc, lambda: lrclib(p["artist"], clean_title(p["title"]), length_s, wait)[0])
    if text:
        w.put(gen, "lyrics.lrc", text.encode())
        w.note(gen, source="lrclib")
    log(f"  lyrics: {text.count(chr(10)) + 1 if text else 0} lines")
    evict(SONGS, MAX_SONGS, keep={tid})


def other_song(w, p, gen, wait):
    cover = fetch_art(p["art"])
    if cover:
        w.put(gen, "cover.jpg", cover)
    key = hashlib.sha1(f"{p['artist']}|{p['title']}".lower().encode()).hexdigest()
    length_s = p["length"] / 1e6 or None
    text = saved_lyrics(MUSIC / f"{key}.lrc",
                        lambda: lrclib(p["artist"], clean_title(p["title"]), length_s, wait)[0])
    if text:
        w.put(gen, "lyrics.lrc", text.encode())
        w.note(gen, source="lrclib")
    log(f"  cover: {'yes' if cover else 'none'}, lyrics: {text.count(chr(10)) + 1 if text else 0} lines")
    evict(MUSIC, MAX_SONGS, keep={key})


def browser_song(w, p, gen, wait):
    """Browsers: the video's thumbnail and captions when it is a YouTube video we
    can identify, else LRCLIB lyrics for the song named in the title."""
    alive = lambda: w.alive(gen)
    cover = fetch_art(p["art"])         # the browser's own small thumbnail, right away
    if cover:
        w.put(gen, "cover.jpg", cover)
    artist, track = youtube_song(p["title"], p["artist"])
    w.note(gen, artist=artist)
    length_s = p["length"] / 1e6

    info = {}
    def video_info():                   # one yt-dlp call, only if something needs it
        if not info:
            out = ytdlp(["-J", "--skip-download", f"https://www.youtube.com/watch?v={vid}"], alive)
            info.update(json.loads(out) if out else {"failed": True})
        return None if "failed" in info else info

    # Which video is it? From the page URL (Plasma Integration, Firefox), else search.
    vid, expected = video_id(p["url"]), 0
    if vid:
        found = recall(IDS, "id:" + vid)
        if found:
            expected = found[1]
        elif video_info() and video_info().get("duration"):
            expected = round(video_info()["duration"] * 1000)
            remember(IDS, "id:" + vid, vid, expected)
    elif length_s >= 60:                # shorter: probably an ad, don't search
        key = hashlib.sha1(f"{p['title']}|{p['artist']}|{round(length_s)}".encode()).hexdigest()
        found = recall(IDS, key)
        if found is None:
            out = ytdlp(["--flat-playlist", "-J", f"ytsearch5:{p['title']} {p['artist']}"], alive)
            if out is not None:
                found = match_search(json.loads(out).get("entries"), p["title"], p["artist"], length_s) or ("", 0)
                remember(IDS, key, *found)
        vid, expected = found or ("", 0)
        vid = vid or None

    if vid:
        thumb = THUMBS / f"{vid}.jpg"
        if not thumb.exists():
            for size in ("maxresdefault", "mqdefault"):    # both 16:9; hq/sd have black bars
                try:
                    write_atomic(thumb, http(f"https://i.ytimg.com/vi/{vid}/{size}.jpg"))
                    break
                except HttpError:
                    continue
        if thumb.exists():
            thumb.touch()
            w.put(gen, "cover.jpg", thumb.read_bytes())

    # Without a video id there is no real length to compare: then anything
    # under a minute counts as an ad (different videos of one song differ in length)
    song_key = vid or hashlib.sha1(f"{artist}|{track}".lower().encode()).hexdigest()
    if ad_playing(p["length"], expected) or (not expected and length_s < 60):
        w.note(gen, expected_ms=expected or "")
        log("  looks like an ad, waiting for the video")
        return
    expected = expected or round(length_s * 1000)
    w.note(gen, expected_ms=expected)

    def captions(kind):
        data = video_info()
        if data is None:
            return None                 # unknown, ask again next time
        url = caption_url(data, kind)
        return json3_to_lrc(json.loads(http(url))) if url else ""

    def from_lrclib():
        lrc, duration = lrclib(artist, track, expected / 1000, wait)
        shift = intro_offset(expected / 1000, duration) if lrc and vid else 0
        if shift:
            log(f"  offset +{shift}s")
            lrc = shift_lrc(lrc, shift)
        return lrc

    text, source = "", ""
    sources = [(CAPTIONS / f"{vid}.lrc", lambda: captions("manual"), "captions")] if vid else []
    sources.append((MUSIC / f"{song_key}.lrc", from_lrclib, "lrclib"))
    if vid:
        sources.append((CAPTIONS / f"{vid}.auto.lrc", lambda: captions("auto"), "auto-captions"))
    for path, get, name in sources:
        text = saved_lyrics(path, get)
        if text:
            source = name
            break
    if text:
        w.put(gen, "lyrics.lrc", text.encode())
        w.note(gen, source=source)
    log(f"  video: {vid or 'unknown'}, lyrics: {source or 'none'}")
    for folder in (THUMBS, CAPTIONS):
        evict(folder, 2 * MAX_VIDEOS, VIDEO_DAYS, keep={vid, f"{vid}.auto"})
    evict(MUSIC, MAX_SONGS, keep={song_key})


def fetch(w, p, gen):
    def wait(seconds):
        """Sleeps; False as soon as another song started."""
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            if not w.alive(gen):
                return False
            time.sleep(0.2)
        return w.alive(gen)

    handler = (spotify_song if is_spotify(p["name"])
               else browser_song if BROWSERS.search(p["name"]) else other_song)
    try:
        handler(w, p, gen, wait)
    except (HttpError, OSError, ValueError, KeyError) as e:     # ValueError covers bad JSON
        log(f"  stopped: {e}")


# ---------------------------------------------------------------- main

def status():
    """--status: what the helper sees and what the lock screen will show."""
    players = dedupe(snapshot())
    for p in players:
        log(f"player  {p['name']:<32} {p['status']:<8} {p['artist']} - {p['title']}")
    current = pick(players, {})
    log(f"chosen  {current['name'] if current else 'none'}")
    try:
        fields = (CACHE / "now.txt").read_text().rstrip("\n").split("\t")
    except OSError:
        fields = []
    for label, value in zip(("now     ", "title   ", "artist  ", "lyrics  ", "length  "), fields):
        log(f"{label}{value or '-'}")
    for name in ("cover.jpg", "lyrics.lrc"):
        f = CACHE / name
        log(f"file    {name}: {f'{f.stat().st_size} bytes' if f.exists() else 'missing'}")
    if current and BROWSERS.search(current["name"]):
        log(f"video   {video_id(current['url']) or 'no URL from the browser, found by searching'}")
    pbi = any(p["name"].startswith("plasma-browser-integration") for p in players)
    for tool, ok, fix in (("yt-dlp", shutil.which("yt-dlp"), "sudo dnf install yt-dlp"),
                          ("node", shutil.which("node"), "sudo dnf install nodejs22"),
                          ("Plasma Integration", pbi, "browser extension, gives exact YouTube videos")):
        log(f"check   {tool}: {'ok' if ok else 'missing - ' + fix}")


def main():
    if "--status" in sys.argv:
        return status()
    for folder in (SONGS, MUSIC, THUMBS, CAPTIONS):
        folder.mkdir(parents=True, exist_ok=True)
    evict(MUSIC, MAX_SONGS)
    for folder in (THUMBS, CAPTIONS):
        evict(folder, 2 * MAX_VIDEOS, VIDEO_DAYS)
    w = Writer(CACHE)
    shown, seen, last_change = (), {}, {}
    # shortcut: polls playerctl once a second instead of following D-Bus signals;
    # fine for one helper per user, revisit if it ever shows up in CPU profiles
    while True:
        players = dedupe(snapshot())
        for p in players:
            state = (p["title"], p["status"], p["length"])
            if seen.get(p["name"]) != state:
                seen[p["name"]], last_change[p["name"]] = state, time.monotonic()
        current = pick(players, last_change)
        key = current and (current["name"], current["title"], current["artist"],
                           current["length"] // 1_000_000)
        if key != shown:
            shown = key
            gen = w.switch(current)
            if current:
                log(f"Now playing ({current['name']}): {current['artist']} - {current['title']}")
                threading.Thread(target=fetch, args=(w, current, gen), daemon=True).start()
        time.sleep(1)


if __name__ == "__main__":
    main()
