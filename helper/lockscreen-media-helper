#!/usr/bin/env python3
"""
Follows every media player (Spotify, browsers, VLC ...) and saves the cover
and synced lyrics of the one the lock screen shows into
~/.cache/kde-lockscreen-lyrics, where the lock screen reads them:

  cover.jpg   lyrics.lrc   now.txt  (player, title, artist, source, expected length)

now.txt tells the lock screen which song the other two files belong to, so it
never shows one song's cover or lyrics with another song's title.
"""

import os
import re
import subprocess
import sys
import time
from pathlib import Path

CACHE = Path.home() / ".cache/kde-lockscreen-lyrics"

SEP = "\x1f"    # playerctl output field separator; never appears in titles
FIELDS = ("name", "status", "trackid", "art", "artist", "title", "length", "url", "kde_pid")
FORMAT = SEP.join(("{{playerName}}", "{{status}}", "{{mpris:trackid}}", "{{mpris:artUrl}}",
                   "{{artist}}", "{{title}}", "{{mpris:length}}", "{{xesam:url}}", "{{kde:pid}}"))


def log(*args):
    print(*args, flush=True)


# ---------------------------------------------------------------- players

def parse_snapshot(text):
    """playerctl -a metadata --format FORMAT output -> list of player dicts."""
    players = []
    for line in text.splitlines():
        parts = line.split(SEP)
        if len(parts) != len(FIELDS):
            continue    # "No player could handle this command" and similar
        p = dict(zip(FIELDS, parts))
        p["length"] = int(p["length"]) if p["length"].isdigit() else 0
        players.append(p)
    return players


def snapshot():
    try:
        out = subprocess.run(["playerctl", "-a", "metadata", "--format", FORMAT],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    return parse_snapshot(out)


def dedupe(players):
    """Plasma Browser Integration repeats the browser's own player (and adds the
    page URL); drop the browser's copy, like Plasma's media applet does."""
    pids = {p["kde_pid"] for p in players if p["kde_pid"]}
    def own_pid(name):     # "brave.instance42" / "firefox.instance_1_42" -> "42"
        m = re.search(r"\.instance.*?(\d+)$", name)
        return m and m[1]
    return [p for p in players if own_pid(p["name"]) not in pids]


def pick(players, last_change):
    """The player to show: has a title, then playing, then Spotify, then most recently changed.
    The lock screen (NowPlaying.qml) uses the same order."""
    candidates = [p for p in players if p["title"]]
    if not candidates:
        return None
    return max(candidates, key=lambda p: (p["status"] == "Playing", p["name"] == "spotify",
                                          last_change.get(p["name"], 0)))


# ---------------------------------------------------------------- cache

def evict(folder, max_items, max_age_days=None, keep=()):
    """Delete songs (all files sharing a name) older than max_age_days, then the
    least recently used ones while there are more than max_items."""
    songs = {}
    for f in folder.iterdir():
        if not f.name.startswith("."):
            songs.setdefault(f.stem, []).append(f)

    def last_used(stem):
        return max((f.stat().st_mtime for f in songs[stem] if f.exists()), default=0)

    stale = []
    if max_age_days is not None:
        cutoff = time.time() - max_age_days * 86400
        stale = [s for s in songs if s not in keep and last_used(s) < cutoff]
    rest = sorted((s for s in songs if s not in keep and s not in stale), key=last_used)
    extra = len(songs) - len(stale) - max_items
    for stem in stale + rest[:max(extra, 0)]:
        for f in songs[stem]:
            f.unlink(missing_ok=True)


